set positional-arguments
set shell := ["bash", "-euco", "pipefail"]

# This justfile owns all ergogen + KiCad recipes. Run from the repo root
# via `just hardware <recipe>` (which does `cd hardware && just`), or
# `cd hardware && just <recipe>` directly.
#
# justfile_directory() resolves to hardware/ in both cases.

hw := justfile_directory()
ergogen := hw / "ergogen"

# Open picker with "jj" alias
[no-cd]
_default:
    @just --list --list-submodules

# Passthrough to root for firmware recipes (just firmware <recipe>).
firmware +args:
    cd "{{ hw }}/../firmware" && just {{ args }}

# Passthrough to root for root-level recipes.
root +args:
    cd "{{ hw }}/.." && just {{ args }}

[group('ergogen')]
setup:
    cd "{{ hw }}" && pnpm install

[group('ergogen')]
ergogen-build:
    cd "{{ hw }}" && pnpm run ergogen:build

[group('ergogen')]
ergogen-watch:
    cd "{{ hw }}" && pnpm run ergogen:watch

# Export every JSCAD case file to STL.
[group('ergogen')]
ergogen-stl-from-jscad:
    cd "{{ hw }}" && npx @jscad/cli@1 ergogen/output/cases/case.jscad -of stla -o ergogen/output/cases/case.stl
    cd "{{ hw }}" && npx @jscad/cli@1 ergogen/output/cases/bottom_plate.jscad -of stla -o ergogen/output/cases/bottom_plate.stl
    cd "{{ hw }}" && npx @jscad/cli@1 ergogen/output/cases/switch_plate.jscad -of stla -o ergogen/output/cases/switch_plate.stl

# Build the case STL for both halves (left + mirrored right).
[group('ergogen')]
case-stl: ergogen-stl-from-jscad
    cp "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_left.stl"
    python3 "{{ ergogen }}/mirror_stl_x.py" "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_right.stl"

# Build just the left-half case STL (ergogen output).
[group('ergogen')]
case-left-stl: ergogen-stl-from-jscad
    cp "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_left.stl"

# Build just the right-half case STL (mirrored left).
[group('ergogen')]
case-right-stl: ergogen-stl-from-jscad
    python3 "{{ ergogen }}/mirror_stl_x.py" "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_right.stl"

# Preview a generated outline (DXF) and re-render on changes.
[group('ergogen')]
visualize-dxf dxf-file="{{ ergogen }}/output/outlines/stack_ol.dxf":
    # uv tool run 'ezdxf[draw]' view "{{ dxf-file }}"
    # uv tool run "ezdxf[draw]" view  "{{ ergogen }}/output/outlines/combo_ol.dxf"
    # watchexec -e dxf -w "{{ ergogen }}/output/outlines" -- uv tool run 'ezdxf[draw]' view "{{ dxf-file }}"
    watchexec -r -w "{{ ergogen }}/output/outlines" 'uv tool run "ezdxf[draw]" view "{{ dxf-file }}"'

kicad-pcb := "shield-pcb"

[group('kicad')]
kicad-checks:
    kicad-cli pcb drc "{{ ergogen }}/output/pcbs/shield-pcb.kicad_pcb"
    # kicad-cli sch check "{{ ergogen }}/schematic/ergogenesis.kicad_sch"
    # kicad-cli pcb check "{{ ergogen }}/output/pcb/ergogenesis.kicad_pc"

# Run DRC with AISLER manufacturer rules.
# Profiles: aisler-2L-simple, aisler-2L-hd (default), aisler-4L-hd

# Rules from ergogen/drc/*.kicad_dru (downloaded from AislerHQ/aisler-support).
[group('kicad')]
kicad-drc-aisler profile="aisler-2L-hd" pcb="{{ ergogen }}/manual/shield-pcb.kicad_pcb":
    #!/usr/bin/env python3
    import json, shutil, os, subprocess, sys

    pcb      = "{{ pcb }}"
    profile  = "{{ profile }}"
    base     = os.path.splitext(pcb)[0]
    pro_path = base + ".kicad_pro"
    dru_dst  = base + ".kicad_dru"
    dru_src  = "{{ ergogen }}/drc/" + profile + ".kicad_dru"

    rules_map = {
        "aisler-2L-simple": {"min_clearance": 0.15,  "min_track_width": 0.2,   "min_via_diameter": 0.7,  "min_via_annular_width": 0.2,  "min_through_hole_diameter": 0.3},
        "aisler-2L-hd":     {"min_clearance": 0.125, "min_track_width": 0.125, "min_via_diameter": 0.45, "min_via_annular_width": 0.1,  "min_through_hole_diameter": 0.25},
        "aisler-4L-hd":     {"min_clearance": 0.125, "min_track_width": 0.125, "min_via_diameter": 0.45, "min_via_annular_width": 0.1,  "min_through_hole_diameter": 0.25},
    }
    if profile not in rules_map:
        print(f"Unknown profile '{profile}'. Choose from: {', '.join(rules_map)}")
        sys.exit(1)

    # Back up existing .kicad_pro, patch with AISLER rules
    backed_up = os.path.exists(pro_path)
    if backed_up:
        shutil.copy2(pro_path, pro_path + ".bak")
        d = json.load(open(pro_path))
    else:
        d = {"board": {"design_settings": {"rules": {}}}}
    d["board"]["design_settings"]["rules"].update(rules_map[profile])
    json.dump(d, open(pro_path, "w"), indent=2)

    # Copy custom DRC rules (.kicad_dru)
    shutil.copy2(dru_src, dru_dst)

    # Run DRC
    print(f"=== DRC with {profile} rules on {pcb} ===")
    result = subprocess.run(["kicad-cli", "pcb", "drc", "--exit-code-violations", "--severity-error", pcb],
                            capture_output=True, text=True)
    print(result.stdout)
    if result.stderr:
        print(result.stderr, file=sys.stderr)

    # Restore originals
    if backed_up:
        shutil.move(pro_path + ".bak", pro_path)
    else:
        os.remove(pro_path)
    os.remove(dru_dst)

    sys.exit(result.returncode)

# NOTE: multi-threaded route optimization is currently broken upstream —
# Freerouting logs "Multi-threaded route optimization is broken and it is
# known to generate clearance violations" and explicitly recommends `-mt 1`.
# So leave threads at 1 regardless of core count.
#
# `-mt 0` / `router.max_threads=0` would DISABLE optimization entirely — do not use.
# `-inc GND`: let the B.Cu ground pour handle GND, not the autorouter.
#   KiCad exports the zone outline as a Specctra `plane` regardless of fill
#   state, so leave the zone unfilled, route, import the .ses, then fill in

# KiCad and run DRC (`just kicad-checks`).
[group('kicad')]
kicad-freerouting-gui:
    # nix-shell -p freerouting --run 'freerouting'
    nix shell nixpkgs#freerouting \
        --command freerouting \
        -da \
        -de "{{ ergogen }}/manual/shield-pcb.dsn" \
        -do "{{ ergogen }}/manual/shield-pcb-routed.ses" \
        -di "{{ ergogen }}/manual/" \
        -inc GND \
        -mt 1 \
        --router.optimizer.max_threads=0 \
        -us global \
        -oit 0

# other cli args: https://github.com/freerouting/freerouting/blob/master/docs/command_line_arguments.md
#  --gui.enabled=false
# other settings: https://github.com/freerouting/freerouting/blob/master/docs/settings.md
# has api server! use from Kicad?
# Export the populated PCB (board + all 3D component models) to a 3D format.
# `format` is one of: step, stl, glb, vrml, ply, u3d, brep, xao.

# The ERGOGEN_3DMODELS variable resolves the ${...} paths in the footprints.
[group('kicad')]
kicad-export-3d format="step":
    kicad-cli pcb export {{ format }} \
        -o "{{ ergogen }}/output/pcbs/shield-pcb.{{ format }}" \
        -D ERGOGEN_3DMODELS="{{ ergogen }}/3dmodels" \
        --force \
        "{{ ergogen }}/output/pcbs/shield-pcb.kicad_pcb"

[group('kicad')]
kicad-export-pdf:
    # front
    kicad-cli pcb export pdf \
        -l F.Cu,F.Adhesive,F.Paste,F.Silkscreen,F.Mask,F.Courtyard,F.Fab,Edge.Cuts \
        --output "{{ hw }}/pcb-FRONT.pdf" \
        --black-and-white \
        --include-border-title \
        "{{ ergogen }}/output/pcbs/shield-pcb.kicad_pcb"
    # back
    kicad-cli pcb export pdf \
        -l B.Cu,B.Adhesive,B.Paste,B.Silkscreen,B.Mask,B.Courtyard,B.Fab,Edge.Cuts \
        --output "{{ hw }}/pcb-BACK.pdf" \
        --black-and-white \
        --include-border-title \
        "{{ ergogen }}/output/pcbs/shield-pcb.kicad_pcb"

# -----------------------------------------------------------------------------
# FreeCAD: build STEP/STL from DXF and compare vs JSCAD
# -----------------------------------------------------------------------------
freecad_cmd := env_var_or_default("FREECAD_CMD", "FreeCADCmd")

[group('freecad')]
freecad-build-plates:
    just hardware ergogen-build
    plate_thickness=$(rg -n '^\s*plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml")
    bottom_plate_thickness=$(rg -n '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml")
    # switch plate
    {{ freecad_cmd }} -c "{{ ergogen }}/freecad/extrude_dxf.py" -- \
        "{{ ergogen }}/output/outlines/switch_plate_ol.dxf" \
        "$plate_thickness" \
        "{{ ergogen }}/output/cases/switch_plate_freecad.step" \
        "{{ ergogen }}/output/cases/switch_plate_freecad.stl" \
        0.05
    # bottom plate
    {{ freecad_cmd }} -c "{{ ergogen }}/freecad/extrude_dxf.py" -- \
        "{{ ergogen }}/output/outlines/bottom_plate_ol.dxf" \
        "$bottom_plate_thickness" \
        "{{ ergogen }}/output/cases/bottom_plate_freecad.step" \
        "{{ ergogen }}/output/cases/bottom_plate_freecad.stl" \
        0.05

[group('freecad')]
freecad-build-case:
    just hardware ergogen-build
    bottom_plate_thickness=$(rg -n '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml")
    standoff_height=$(rg -n '^\s*standoff_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml")
    wall_height=$(rg -n '^\s*wall_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml")
    {{ freecad_cmd }} -c "{{ ergogen }}/freecad/build_case.py" -- \
        "{{ ergogen }}/output/outlines" \
        "$bottom_plate_thickness" \
        "$standoff_height" \
        "$wall_height" \
        "{{ ergogen }}/output/cases/case_freecad.step" \
        "{{ ergogen }}/output/cases/case_freecad.stl" \
        0.05

[group('freecad')]
freecad-compare:
    just hardware ergogen-stl-from-jscad
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/switch_plate.stl" "{{ ergogen }}/output/cases/switch_plate_freecad.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/bottom_plate.stl" "{{ ergogen }}/output/cases/bottom_plate_freecad.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_freecad.stl"

[group('freecad')]
freecad-iterate pieces="all":
    uv run "{{ ergogen }}/freecad/iterate_compare.py" run --pieces {{ pieces }}

[group('freecad')]
freecad-find-cmd:
    uv run "{{ ergogen }}/freecad/iterate_compare.py" find-freecad

# -----------------------------------------------------------------------------
# CadQuery: build STEP/STL from DXF and compare vs JSCAD
# -----------------------------------------------------------------------------
[group('cadquery')]
cq-build-plates:
    just ergogen-build
    uv run "{{ ergogen }}/cadquery/extrude_dxf.py" \
        --dxf "{{ ergogen }}/output/outlines/switch_plate_ol.dxf" \
        --height $(rg '^\s*plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/switch_plate_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/switch_plate_cq.stl"
    uv run "{{ ergogen }}/cadquery/extrude_dxf.py" \
        --dxf "{{ ergogen }}/output/outlines/bottom_plate_ol.dxf" \
        --height $(rg '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/bottom_plate_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/bottom_plate_cq.stl"

[group('cadquery')]
cq-build-case:
    just ergogen-build
    uv run "{{ ergogen }}/cadquery/build_case.py" \
        --dxf-dir "{{ ergogen }}/output/outlines" \
        --bottom-th $(rg '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --standoff-h $(rg '^\s*standoff_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --wall-h $(rg '^\s*wall_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/case_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/case_cq.stl"

[group('cadquery')]
cq-compare:
    just ergogen-stl-from-jscad
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/switch_plate.stl" "{{ ergogen }}/output/cases/switch_plate_cq.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/bottom_plate.stl" "{{ ergogen }}/output/cases/bottom_plate_cq.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_cq.stl"

[group('cadquery')]
cq-iterate:
    # Build everything once, then compare JSCAD vs CadQuery outputs
    just ergogen-build
    # switch plate
    uv run "{{ ergogen }}/cadquery/extrude_dxf.py" \
        --dxf "{{ ergogen }}/output/outlines/switch_plate_ol.dxf" \
        --height $(rg '^\s*plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/switch_plate_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/switch_plate_cq.stl"
    # bottom plate
    uv run "{{ ergogen }}/cadquery/extrude_dxf.py" \
        --dxf "{{ ergogen }}/output/outlines/bottom_plate_ol.dxf" \
        --height $(rg '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/bottom_plate_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/bottom_plate_cq.stl"
    # case
    uv run "{{ ergogen }}/cadquery/build_case.py" \
        --dxf-dir "{{ ergogen }}/output/outlines" \
        --bottom-th $(rg '^\s*bottom_plate_thickness:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --standoff-h $(rg '^\s*standoff_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --wall-h $(rg '^\s*wall_height:\s*([0-9.]+)' -or '$1' "{{ ergogen }}/config.yaml") \
        --out-step "{{ ergogen }}/output/cases/case_cq.step" \
        --out-stl "{{ ergogen }}/output/cases/case_cq.stl"
    # Generate JSCAD STLs and compare
    just ergogen-stl-from-jscad
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/switch_plate.stl" "{{ ergogen }}/output/cases/switch_plate_cq.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/bottom_plate.stl" "{{ ergogen }}/output/cases/bottom_plate_cq.stl"
    uv run "{{ ergogen }}/freecad/compare_meshes.py" compare \
        "{{ ergogen }}/output/cases/case.stl" "{{ ergogen }}/output/cases/case_cq.stl"


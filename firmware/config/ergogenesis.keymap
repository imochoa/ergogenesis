// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT  k2  &ht LCTRL k3  &ht LGUI  k4
#define HRMR(k1,k2,k3,k4) &ht RGUI  k1  &ht RCTRL k2  &ht RALT  k3  &ht RSHFT k4

#define LY_BAS 0
#define LY_SYM 1
#define LY_NUM 2
#define LY_CTL 3
#define LY_FN9 4
#define LY_FN19 5
#define LY_FN24 6

// OverKeys layer indicators (see overkeys/README.md). The host overlay cannot
// see ZMK layers, so a layer-tap also holds a trigger key while its layer is
// active. Keep in sync with TRIGGERS in overkeys/convert.py. macOS only
// reports F1-F20, so F21-F24 cannot be used as triggers.
//
// Off by default. Enable with `just firmware build-firmware-overkeys`, which
// passes -DOVERKEYS_INDICATORS to the devicetree preprocessor, or uncomment
// the define below. This cannot be a Kconfig option: devicetree is processed
// before Kconfig, so CONFIG_* symbols are not visible in a keymap.
//
// TODO: test on hardware. The enabled variant compiles but was never flashed.
// #define OVERKEYS_INDICATORS
#define OVK_SYM F20
// keymap-drawer predefines OVK_MO_SYM as plain &mo (firmware/draw/config.yaml)
// so the rendered layout always recognises the key as a layer activator.
#ifndef OVK_MO_SYM
#ifdef OVERKEYS_INDICATORS
#define OVK_MO_SYM &mo_sym
#else
#define OVK_MO_SYM &mo
#endif
#endif

//
// #define LY_NAV 3

// rango keyboard toggle with ctrl-shift-5

// ref layers https://github.com/zmkfirmware/zmk/blob/e93cd31a5866cd4f50385bece7a3fb770f2ca6f8/app/boards/shields/cradio/cradio.keymap#L4

// Caps-word: capitalises letters until a key outside this list is typed.
// MINUS is added so CONSTANT-STYLE and kebab identifiers do not end it.
&caps_word {
	continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

/ {
	// {{{1 Combos
	// https://zmk.dev/docs/keymaps/combos
	combos {
		compatible = "zmk,combos";
		// Keys
		/* key_super { */
		/* 	// Windows key was missing! */
		/* 	key-positions = <LM1 RM1>; */
		/* 	timeout-ms = <50>; */
		/* 	layers = < LY_BAS >; */
		/* 	bindings = <&kp LWIN>; */
		/* }; */

		// Combo behaviors are evaluated on the central half, so binding a
		// three-key combo directly to &bootloader always resets the left half.
		// Instead, the first two keys momentarily select LY_CTL; the third key
		// is then handled normally and &bootloader follows that key's source.
		// Hold T+G, then press B to boot the left half.
		bootloader_l_prep {
			key-positions = <LT0 LM0>;
			timeout-ms = <100>;
			layers = <LY_BAS>;
			bindings = <&mo LY_CTL>;
		};

		// Hold Y+H, then press N to boot the right half.
		bootloader_r_prep {
			key-positions = <RT0 RM0>;
			timeout-ms = <100>;
			layers = <LY_BAS>;
			bindings = <&mo LY_CTL>;
		};

		// Both pinkies (A + ;, the two Shift home-row mods) toggle caps-word:
		// the usual "both shifts" gesture. Skipped while typing.
		caps_word_combo {
			key-positions = <LM4 RM4>;
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			layers = <LY_BAS>;
			bindings = <&caps_word>;
		};
  	// key_escape {
		//     // Wanted a way to avoid 2 layer switches while pressing escape in vim
		//     // emulates C-[
		//     key-positions = <LB4 RT4>;
		//     timeout-ms = <50>;
		//     // layers = < LY_BAS LY_SYM >;
		//     bindings = <&kp ESC>;
		// };
		// key_escape {
		//     // Wanted a way to avoid 2 layer switches while pressing escape in vim
		//     // emulates C-[
		//     key-positions = <LB4 RT4>;
		//     timeout-ms = <50>;
		//     // layers = < LY_BAS LY_SYM >;
		//     bindings = <&kp ESC>;
		// };
		// fn1_combo {
		//     key-positions = <LT1 RB1>;
		//     timeout-ms = <50>;
		//     layers = < LY_NUM >;
		//     bindings = <&kp F1>;
		// };
	};
	
	// {{{1 Macros
	// https://zmk.dev/docs/keymaps/behaviors/macros
	macros {
#ifdef OVERKEYS_INDICATORS
		// &mo <layer> plus the OverKeys trigger key, both held until release.
		mo_sym: mo_sym {
			compatible = "zmk,behavior-macro-one-param";
			#binding-cells = <1>;
			wait-ms = <0>;
			tap-ms = <0>;
			bindings
				= <&macro_press>, <&macro_param_1to1>, <&mo MACRO_PLACEHOLDER>, <&kp OVK_SYM>
				, <&macro_pause_for_release>
				, <&macro_release>, <&kp OVK_SYM>, <&macro_param_1to1>, <&mo MACRO_PLACEHOLDER>;
		};
#endif
	};
	
	// {{{1 Behaviors
	// https://zmk.dev/docs/keymaps/behaviors#key-press-behaviors
	// https://zmk.dev/docs/keymaps/behaviors#user-defined-behaviors
	behaviors {
		ht: hold_tap {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			// flavor = "tap-preferred";
			flavor = "balanced";
			tapping-term-ms = <220>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <100>;
			bindings = <&kp>, <&kp>;
		};
		td0: tap_dance_0 {
			compatible = "zmk,behavior-tap-dance";
			label = "TAPDANCE";
			#binding-cells = <0>;// No inputs
			tapping-term-ms = <200>;
			bindings = <&kp N1>, <&kp N2>, <&kp N3>;// outputs
		};
		// https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#layer-tap
		/* urob timeless HRM */
		// 150 ms caused missed modifiers with the lighter switches. Keep the
		// right hand at 100 ms, but let left-hand modifiers follow Space within
		// 75 ms so the A/Shift key can reliably capitalize the next letter.
		/* Left-hand HRMs. */
		hml: hml {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <75>;
			bindings = <&kp>, <&kp>;
			// Before the tapping term, keys not listed here force a tap.
			hold-trigger-key-positions = <KEYS_R THUMBS>;
			hold-trigger-on-release;
		};
		/* Right-hand HRMs. */
		hmr: hmr {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <100>;
			bindings = <&kp>, <&kp>;
			hold-trigger-key-positions = <KEYS_L THUMBS>;
			hold-trigger-on-release;
		};
		/* Space is tap-preferred so rolling into the next letter cannot turn it
		 * into the number-layer hold. Hold it deliberately for 200 ms first. */
		/* Symbols/Backspace stays responsive: another key press resolves it as
		 * a hold immediately. With OVERKEYS_INDICATORS the hold is &mo_sym so
		 * OverKeys sees the layer; otherwise it is plain &mo. */
		lt_sym: layer_tap_symbols {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			require-prior-idle-ms = <100>;
			bindings = <OVK_MO_SYM>, <&kp>;
		};
		lt_num: layer_tap_number {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&kp>;
		};
	};
	
	// {{{1 conditional-layers
	conditional_layers {
		compatible = "zmk,conditional-layers";
		tri_layer {
			if-layers = <LY_SYM LY_NUM>;
			then-layer = <LY_CTL>;
		};
	};
	
	// {{{1 Keymap
	keymap {
		compatible = "zmk,keymap";
		// {{{1 [0] LY_BAS
		default_layer {
			display-name = "Base";
			bindings = <
//        ┌─────────────┬─────────────┬─────────────┬────────────────┬─────┐   ┌─────┬───────────────┬─────────────┬─────────────┬─────────────┐
//        │      Q      │      W      │      E      │       R        │  T  │   │  Y  │       U       │      I      │      O      │      P      │
//        ├─────────────┼─────────────┼─────────────┼────────────────┼─────┤   ├─────┼───────────────┼─────────────┼─────────────┼─────────────┤
//        │ &hml lsft A │ &hml lalt S │ &hml lctl D │  &hml lgui F   │  G  │   │  H  │  &hmr rgui J  │ &hmr rctl K │ &hmr ralt L │ &hmr rsft ; │
//        ├─────────────┼─────────────┼─────────────┼────────────────┼─────┤   ├─────┼───────────────┼─────────────┼─────────────┼─────────────┤
//        │      Z      │      X      │      C      │       V        │  B  │   │  N  │       M       │      ,      │      .      │      /      │
//        └─────────────┴─────────────┼─────────────┼────────────────┼─────┤   ├─────┼───────────────┼─────────────┼─────────────┴─────────────┘
//                                    │     f17     │ lt_sym SYM BKSP│ del │   │ tab │ lt_num NUM spc │     f10     │
//                                    └─────────────┴────────────────┴─────┘   └─────┴───────────────┴─────────────┘
      &kp Q           &kp W         &kp E          &kp R             &kp T         &kp Y     &kp U              &kp I          &kp O         &kp P
      &hml LSHIFT A   &hml LALT S   &hml LCTRL D   &hml LGUI F       &kp G         &kp H     &hmr RGUI J        &hmr RCTRL K   &hmr RALT L   &hmr RSHIFT SEMI
      &kp Z           &kp X         &kp C          &kp V             &kp B         &kp N     &kp M              &kp COMMA      &kp DOT       &kp FSLH
                                    &kp F17        &lt_sym LY_SYM BKSP   &kp DEL       &kp TAB   &lt_num LY_NUM SPACE   &kp F10
			>;// kinesis has enter where I put tab
		};
		
		// {{{1 [1] LY_SYM
		symbols_layer {
			display-name = "Symbols";
			bindings = <
//        ┌───────────────┬─────────────┬─────────────┬─────────────┬─────┐   ┌─────┬─────────────┬─────────────┬─────────────┬───────────────┐
//        │       !       │      @      │      #      │      $      │  %  │   │  ^  │      &      │      *      │   mt _ -    │       =       │
//        ├───────────────┼─────────────┼─────────────┼─────────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┼───────────────┤
//        │ &hml lsft esc │ &hml lalt ` │ &hml lctl ' │ &hml lgui " │     │   │     │ &hmr rgui ( │ &hmr rctl ) │ &hmr ralt \ │ &hmr rsft ent │
//        ├───────────────┼─────────────┼─────────────┼─────────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┼───────────────┤
//        │       ~       │             │    left     │    rght     │     │   │     │    down     │     up      │      [      │       ]       │
//        └───────────────┴─────────────┼─────────────┼─────────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┴───────────────┘
//                                      │             │             │     │   │     │             │             │
//                                      └─────────────┴─────────────┴─────┘   └─────┴─────────────┴─────────────┘
      &kp EXCL          &kp AT            &kp HASH         &kp DOLLAR      &kp PRCNT       &kp CARET   &kp AMPS         &kp STAR          &mt UNDER MINUS   &kp EQUAL
      &hml LSHIFT ESC   &hml LALT GRAVE   &hml LCTRL SQT   &hml LGUI DQT   &none           &none       &hmr RGUI LPAR   &hmr RCTRL RPAR   &hmr RALT BSLH    &hmr RSHIFT ENTER
      &kp TILDE         &none             &kp LEFT         &kp RIGHT       &none           &none       &kp DOWN         &kp UP            &kp LBKT          &kp RBKT
                                          &trans           &trans          &trans          &trans      &trans           &trans
			>;
			// " is a bit awkward to type
			// left-side shift requires left thumb and right shift -> weird! avoid it
			// TODO: put unused keys in <24> <25> (e.g. ^ %)
		};
		// {{{1 [2] LY_NUM
		num_layer {
			display-name = "Numbers";
			bindings = <
//        ┌──────┬───────────┬───────────┬──────────┬─────┐   ┌─────┬─────────────┬─────────────┬─────────────┬───────────────┐
//        │      │ mo LY_f24 │ mo LY_f19 │ mo LY_F9 │     │   │     │      7      │      8      │      9      │               │
//        ├──────┼───────────┼───────────┼──────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┼───────────────┤
//        │ lsft │   lalt    │   lctl    │   lgui   │     │   │     │ &hmr rgui 4 │ &hmr rctl 5 │ &hmr ralt 6 │ &hmr rsft ent │
//        ├──────┼───────────┼───────────┼──────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┼───────────────┤
//        │      │           │           │          │     │   │     │      1      │      2      │      3      │       0       │
//        └──────┴───────────┼───────────┼──────────┼─────┤   ├─────┼─────────────┼─────────────┼─────────────┴───────────────┘
//                           │           │          │     │   │     │             │             │
//                           └───────────┴──────────┴─────┘   └─────┴─────────────┴─────────────┘
      &none        &mo LY_FN24   &mo LY_FN19   &mo LY_FN9   &none        &none    &kp N7         &kp N8          &kp N9         &none
      &kp LSHIFT   &kp LALT      &kp LCTRL     &kp LGUI     &none        &none    &hmr RGUI N4   &hmr RCTRL N5   &hmr RALT N6   &hmr RSHIFT ENTER
      &none        &none         &none         &none        &none        &none    &kp N1         &kp N2          &kp N3         &kp N0
                                 &trans        &trans       &trans       &trans   &trans         &trans
			>;
			// smart number layer?
			// &mo LY_FN24 -> &lt LY_FN24 SPACE
			// &kp SPACE   -> &lt LY_FN24 SPACE
		};
		
		// {{{1 [3] LY_CTL
		ctl_layer {
			display-name = "Control";
			bindings = <
//        ┌────────────────┬──────────┬──────────┬──────────┬──────┐   ┌──────┬─────┬─────┬─────┬────────────────┐
//        │                │          │          │          │      │   │      │     │     │     │ &studio_unlock │
//        ├────────────────┼──────────┼──────────┼──────────┼──────┤   ├──────┼─────┼─────┼─────┼────────────────┤
//        │    bt_sel 3    │ bt_sel 2 │ bt_sel 1 │ bt_sel 0 │      │   │      │     │     │     │                │
//        ├────────────────┼──────────┼──────────┼──────────┼──────┤   ├──────┼─────┼─────┼─────┼────────────────┤
//        │ &studio_unlock │          │          │          │ boot │   │ boot │     │     │     │     bt_clr     │
//        └────────────────┴──────────┼──────────┼──────────┼──────┤   ├──────┼─────┼─────┼─────┴────────────────┘
//                                    │          │          │      │   │      │     │     │
//                                    └──────────┴──────────┴──────┘   └──────┴─────┴─────┘
      &none            &none          &none          &none          &none             &none         &none    &none    &none   &studio_unlock
      &bt BT_SEL 3     &bt BT_SEL 2   &bt BT_SEL 1   &bt BT_SEL 0   &none             &none         &none    &none    &none   &none
      &studio_unlock   &none          &none          &none          &bootloader       &bootloader   &none    &none    &none   &bt BT_CLR
                                      &trans         &trans         &trans            &trans        &trans   &trans
			>;
			// TODO: macro to print reminder of the bt profiles?
		};
		// {{{1 [4] LY_FN9
		fn1-9_layer {
			display-name = "fn1-9";
			bindings = <
//        ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬────┬─────┐
//        │     │     │     │     │     │   │     │ f7  │ f8  │ f9 │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼────┼─────┤
//        │     │     │     │     │     │   │     │ f4  │ f5  │ f6 │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼────┼─────┤
//        │     │     │     │     │     │   │     │ f1  │ f2  │ f3 │ f10 │
//        └─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼────┴─────┘
//                    │     │     │     │   │     │     │     │
//                    └─────┴─────┴─────┘   └─────┴─────┴─────┘
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F7   &kp F8   &kp F9   &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F4   &kp F5   &kp F6   &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F1   &kp F2   &kp F3   &kp F10
                        &trans   &trans   &trans       &trans   &trans   &trans
			>;
		};
		// {{{1 [5] LY_FN19
		fn10-19_layer {
			display-name = "fn10-19";
			bindings = <
//        ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
//        │     │     │     │     │     │   │     │ f17 │ f18 │ f19 │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┤
//        │     │     │     │     │     │   │     │ f14 │ f15 │ f16 │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┤
//        │     │     │     │     │     │   │     │ f11 │ f12 │ f13 │ f10 │
//        └─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┘
//                    │     │     │     │   │     │     │     │
//                    └─────┴─────┴─────┘   └─────┴─────┴─────┘
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F17   &kp F18   &kp F19   &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F14   &kp F15   &kp F16   &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F11   &kp F12   &kp F13   &kp F10
                        &trans   &trans   &trans       &trans   &trans    &trans
			>;
		};
		
		// {{{1 [6] LY_FN24
		fn20-24_layer {
			display-name = "fn20-24";
			bindings = <
//        ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
//        │     │     │     │     │     │   │     │     │     │     │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┤
//        │     │     │     │     │     │   │     │ f24 │     │     │     │
//        ├─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┤
//        │     │     │     │     │     │   │     │ f21 │ f22 │ f23 │ f20 │
//        └─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┘
//                    │     │     │     │   │     │     │     │
//                    └─────┴─────┴─────┘   └─────┴─────┴─────┘
      &trans   &trans   &trans   &trans   &trans       &trans   &trans    &trans    &trans    &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F24   &trans    &trans    &trans
      &trans   &trans   &trans   &trans   &trans       &trans   &kp F21   &kp F22   &kp F23   &kp F20
                        &trans   &trans   &trans       &trans   &trans    &trans
			>;
		};
		
	};
};

// Gaming layer? (no hmr)
// // {{{1 LAYER 3
//  nav_layer {

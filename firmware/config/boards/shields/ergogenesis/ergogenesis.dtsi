#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

// nRF52840 + Adafruit UF2 bootloader: wire up the retention "boot mode" so the
// `&bootloader` behavior can reboot into the UF2 bootloader. On Zephyr >=3.6 the
// old CONFIG_NRF_STORE_REBOOT_TYPE_GPREGRET mechanism was removed, so bootloader
// entry now goes through the retention boot-mode subsystem + magic-value mapper
// (writes 0x57 to GPREGRET). This dtsi ships with ZMK and defines the gpregret
// retention area, the zmk,bootmode-to-magic-mapper node, and the chosen nodes.
// Requires CONFIG_RETAINED_MEM/RETENTION/RETENTION_BOOT_MODE (see ergogenesis.conf).
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // Each half is a 5-column x 4-row matrix. The three thumb keys occupy
    // columns 2-4 of row 3. The right half applies col-offset = <5> and the
    // map reverses those columns to match the visually mirrored layout.
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                        RC(3,2) RC(3,3) RC(3,4)   RC(3,9) RC(3,8) RC(3,7)
        >;
    };

    // Custom 36-key physical layout (this is a 3+3-thumb board, so the built-in
    // 34-key cuddlykeyboards ferris layout does NOT match). Required for ZMK
    // Studio, which maps firing positions to physical keys via this node.
    //
    // key_physical_attrs: width height x y rotation rot-origin-x rot-origin-y
    // Units are 1/100 of a key. Entry order matches the keymap position order
    // in 36.h: top / home / bottom rows (L pinky->inner, R inner->pinky), then
    // left thumbs (LH2 LH1 LH0), then right thumbs (RH0 RH1 RH2). x/y are
    // approximated from the column stagger in hardware/ergogen/config.yaml
    // (pinky 0, ring +14mm, middle +4.76mm, index -4.76mm, inner -2.86mm,
    // ky=17mm) shifted positive; refine for a pixel-accurate Studio view.
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Ergogenesis";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w    h    x    y   rot  rx  ry
            = <&key_physical_attrs 100 100    0   82     0   0   0>
            , <&key_physical_attrs 100 100  100    0     0   0   0>
            , <&key_physical_attrs 100 100  200   54     0   0   0>
            , <&key_physical_attrs 100 100  300  110     0   0   0>
            , <&key_physical_attrs 100 100  400   99     0   0   0>
            , <&key_physical_attrs 100 100  600   99     0   0   0>
            , <&key_physical_attrs 100 100  700  110     0   0   0>
            , <&key_physical_attrs 100 100  800   54     0   0   0>
            , <&key_physical_attrs 100 100  900    0     0   0   0>
            , <&key_physical_attrs 100 100 1000   82     0   0   0>
            , <&key_physical_attrs 100 100    0  182     0   0   0>
            , <&key_physical_attrs 100 100  100  100     0   0   0>
            , <&key_physical_attrs 100 100  200  154     0   0   0>
            , <&key_physical_attrs 100 100  300  210     0   0   0>
            , <&key_physical_attrs 100 100  400  199     0   0   0>
            , <&key_physical_attrs 100 100  600  199     0   0   0>
            , <&key_physical_attrs 100 100  700  210     0   0   0>
            , <&key_physical_attrs 100 100  800  154     0   0   0>
            , <&key_physical_attrs 100 100  900  100     0   0   0>
            , <&key_physical_attrs 100 100 1000  182     0   0   0>
            , <&key_physical_attrs 100 100    0  282     0   0   0>
            , <&key_physical_attrs 100 100  100  200     0   0   0>
            , <&key_physical_attrs 100 100  200  254     0   0   0>
            , <&key_physical_attrs 100 100  300  310     0   0   0>
            , <&key_physical_attrs 100 100  400  299     0   0   0>
            , <&key_physical_attrs 100 100  600  299     0   0   0>
            , <&key_physical_attrs 100 100  700  310     0   0   0>
            , <&key_physical_attrs 100 100  800  254     0   0   0>
            , <&key_physical_attrs 100 100  900  200     0   0   0>
            , <&key_physical_attrs 100 100 1000  282     0   0   0>
            , <&key_physical_attrs 100 100  250  440     0   0   0>
            , <&key_physical_attrs 100 100  350  450     0   0   0>
            , <&key_physical_attrs 100 100  450  460     0   0   0>
            , <&key_physical_attrs 100 100  550  460     0   0   0>
            , <&key_physical_attrs 100 100  650  450     0   0   0>
            , <&key_physical_attrs 100 100  750  440     0   0   0>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        // Diodes are wired column -> switch -> diode -> row.
        diode-direction = "col2row";

        // row0/top, row1/home, row2/bottom, row3/thumb
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        // col0/pinky through col4/inner
        col-gpios
            = <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            ;
    };

};

// SK6812 MINI-E data is connected to Pro Micro D16, which is nRF P0.10.
&pinctrl {
    rgb_spi3_default: rgb_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    rgb_spi3_sleep: rgb_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&rgb_spi3_default>;
    pinctrl-1 = <&rgb_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <18>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};

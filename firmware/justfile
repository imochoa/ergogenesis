set positional-arguments
set shell := ["bash", "-euco", "pipefail"]

# All ZMK firmware recipes. This justfile is self-contained: run it via
# `just firmware <recipe>` from the repo root (which does `cd firmware && just`),
# or `cd firmware && just <recipe>` directly.
#
# justfile_directory() resolves to this file's directory (firmware/) in both
# cases, so `fw := justfile_directory()` is consistent everywhere.

fw := justfile_directory()
out := fw

mod in-devc ".just/in-devc.just"
mod flash ".just/flash.just"
mod draw ".just/draw.just"

alias b := build-all

[no-cd]
_default:
    @just --list --list-submodules

# Passthrough to root for hardware recipes (just hardware <recipe>).
hardware +args:
    cd "{{ fw }}/../hardware" && just {{ args }}

# Passthrough to root for root-level recipes.
root +args:
    cd "{{ fw }}/.." && just {{ args }}

# [group('host')]
devc-exec +recipe:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${container:-}" ]; then
      just devc-up
      devcontainer exec \
        --workspace-folder "{{ fw }}" \
        --docker-path podman \
        --docker-compose-path podman-compose \
        -- bash -lc 'just "$@"' _ {{ recipe }}
    else
      bash -c 'just "$@"' _ {{ recipe }}
    fi

# [group('host')]
devc-build:
    devcontainer build \
      --workspace-folder "{{ fw }}" \
      --docker-path podman \
      --docker-compose-path podman-compose

# [group('host')]
devc-up:
    devcontainer up \
      --workspace-folder "{{ fw }}" \
      --docker-path podman \
      --docker-compose-path podman-compose \
      --remove-existing-container
    podman ps --last 1

# [group('host')]
mkdirs:
    @just devc-exec in-devc mkdirs

# [group('host')]
hard-rmdirs:
    @just devc-exec in-devc hard-rmdirs

# initialize west

# [group('host')]
[group('west')]
west-init:
    @just devc-exec in-devc west-init

# you might need to run this multiple times after "init"

# [group('host')]
[group('west')]
west-update:
    @just devc-exec in-devc west-update

[group('west')]
west-reset:
    @just devc-exec in-devc west-reset
# update west

# [group('host')]
update:
    @just devc-exec in-devc update

# Build one firmware target (board shield snippet cmake_args artifact_name).
# snippet/cmake_args may be empty.

# [group('host')]
generic-build board shield snippet="" cmake_args="" artifact_name="" pristine="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${container:-}" ]; then
      just devc-up
      devcontainer exec \
        --workspace-folder "{{ fw }}" \
        --docker-path podman \
        --docker-compose-path podman-compose \
        -- bash -lc 'just in-devc generic-build "$@"' _ \
        "{{ board }}" "{{ shield }}" "{{ snippet }}" "{{ cmake_args }}" "{{ artifact_name }}" "{{ pristine }}"
    else
      just in-devc generic-build "{{ board }}" "{{ shield }}" "{{ snippet }}" "{{ cmake_args }}" "{{ artifact_name }}" "{{ pristine }}"
    fi

# Builds both halves with ZMK Studio.

# [group('host')]
build-firmware: (generic-build "nice_nano" "ergogenesis_left" "studio-rpc-usb-uart" "-DCONFIG_ZMK_STUDIO=y" "ergogenesis_left-nice_nano-zmk" "1") (generic-build "nice_nano" "ergogenesis_right" "studio-rpc-usb-uart" "-DCONFIG_ZMK_STUDIO=y" "ergogenesis_right-nice_nano-zmk" "1")

# https://zmk.dev/docs/troubleshooting/connection-issues#reset-split-keyboard-procedure

# [group('host')]
build-settings-reset-firmware:
    just generic-build nice_nano settings_reset "" "" settings_reset-nice_nano-zmk 1

# [group('host')]
build-all: build-firmware build-settings-reset-firmware

# Generate a self-contained report from each target's effective .config and
# Kconfig tree. The inner recipe must run in the devcontainer because it uses
# Zephyr's vendored Kconfiglib.
[group('ci')]
in-devc-kconfig-report target:
    python3 scripts/kconfig_report.py \
      ".build/nice_nano/{{ target }}" \
      ".build/nice_nano/{{ target }}/zephyr/kconfig-report.html"

[group('ci')]
kconfig-report target:
    just devc-exec in-devc-kconfig-report "{{ target }}"

[group('ci')]
kconfig-report-all: (kconfig-report "ergogenesis_left") (kconfig-report "ergogenesis_right") (kconfig-report "settings_reset")

# Generate a documented, searchable node tree from Zephyr's resolved EDT data.
[group('ci')]
in-devc-devicetree-report target:
    python3 scripts/devicetree_report.py \
      ".build/nice_nano/{{ target }}" \
      ".build/nice_nano/{{ target }}/zephyr/devicetree-report.html"

[group('ci')]
devicetree-report target:
    just devc-exec in-devc-devicetree-report "{{ target }}"

[group('ci')]
devicetree-report-all: (devicetree-report "ergogenesis_left") (devicetree-report "ergogenesis_right") (devicetree-report "settings_reset")

# Build in an ephemeral, CI-owned devcontainer. The workspace caches are bind
# mounts, so removing the container afterward does not discard west/Zephyr data.
# [group('ci')]
ci:
    #!/usr/bin/env bash
    set -euo pipefail
    ci_label="io.imochoa.ci=ergogenesis"
    cleanup() {
      mapfile -t containers < <(podman ps -aq --filter "label=$ci_label")
      if ((${#containers[@]})); then
        podman rm --force "${containers[@]}"
      fi
    }
    trap cleanup EXIT

    # Remove a stale CI container without touching an interactive devcontainer.
    cleanup
    devcontainer up \
      --workspace-folder "{{ fw }}" \
      --docker-path podman \
      --docker-compose-path podman-compose \
      --id-label "$ci_label" \
      --remove-existing-container
    devcontainer exec \
      --workspace-folder "{{ fw }}" \
      --docker-path podman \
      --docker-compose-path podman-compose \
      --id-label "$ci_label" \
      -- bash -lc 'just build-all && just kconfig-report-all && just devicetree-report-all'

    artifacts_dir="${CI_ARTIFACTS_DIR:-$HOME/vps/podman/containers/systemd/nginx/files/artifacts}"
    repo_artifacts="$artifacts_dir/ergogenesis"
    mkdir -p "$repo_artifacts"
    install -m 0644 -- *.uf2 "$repo_artifacts/"
    install -m 0644 "{{ fw }}/draw/base.svg" "$repo_artifacts/ergogenesis-layout.svg"

    # Publish generated configuration for each image; these are the most useful
    # files when investigating unexpected Kconfig or devicetree behavior.
    for target in ergogenesis_left ergogenesis_right settings_reset; do
      build_dir="{{ fw }}/.build/nice_nano/$target/zephyr"
      debug_dir="$repo_artifacts/debug/$target"
      mkdir -p "$debug_dir"
      install -m 0644 "$build_dir/.config" "$debug_dir/combined-kconfig.config"
      install -m 0644 "$build_dir/zephyr.dts" "$debug_dir/zephyr.dts"
      install -m 0644 "$build_dir/zephyr.dts.pre" "$debug_dir/zephyr.dts.pre"
      install -m 0644 "$build_dir/kconfig-report.html" "$debug_dir/kconfig-report.html"
      install -m 0644 "$build_dir/devicetree-report.html" "$debug_dir/devicetree-report.html"
    done
    printf 'Published firmware, layout, and debug outputs to %s\n' "$repo_artifacts"

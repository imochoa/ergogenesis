set positional-arguments := true
set shell := ["bash", "-euco", "pipefail"]

# OverKeys on-screen overlay for the ergogenesis keymap (macOS).
# Run via `just overkeys <recipe>` from the repo root, or `just <recipe>` here.
#
# Uses Coobaha's fork, which adds native macOS key monitoring and physical
# layouts: https://github.com/Coobaha/OverKeys

here := justfile_directory()
app_repo := "https://github.com/Coobaha/OverKeys.git"
app_commit := "cb04642"
app_src := here / ".app-src"
app_bundle := app_src / "build/macos/Build/Products/Release/OverKeys.app"
app_dest := "/Applications/OverKeys.app"
config_out := here / "output/overkeys_config.json"

[no-cd]
_default:
    @just --justfile "{{ justfile() }}" --list

# Generate output/overkeys_config.json from the ZMK keymap.
convert:
    "{{ here }}/convert.py" convert

# Pretty-print the generated config.
show: convert
    python3 -m json.tool "{{ config_out }}"

# Install the generated config into OverKeys (backs up the existing one).
install-config: convert
    "{{ here }}/convert.py" install --no-dry-run

# Clone the OverKeys fork at the pinned commit into .app-src/.
app-checkout:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d "{{ app_src }}/.git" ]; then
      git clone "{{ app_repo }}" "{{ app_src }}"
    fi
    git -C "{{ app_src }}" fetch origin
    # Reset tracked files so app.patch (local build fixes) applies cleanly.
    git -C "{{ app_src }}" checkout --force --detach "{{ app_commit }}"
    git -C "{{ app_src }}" apply "{{ here }}/app.patch"

# Build the macOS app (needs Flutter and Xcode).

# CocoaPods comes from nixpkgs when it is not already on PATH.
app-build: app-checkout
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ app_src }}"
    # Build for the host architecture only: Flutter 3.38's universal-binary
    # check (`lipo -verify_arch arm64 x86_64`) fails with macOS 27's lipo.
    export FLUTTER_XCODE_ARCHS="$(uname -m)"
    export FLUTTER_XCODE_ONLY_ACTIVE_ARCH=YES
    build='flutter --disable-analytics && flutter pub get && flutter build macos --release'
    if command -v pod >/dev/null; then
      bash -euc "$build"
    else
      nix shell nixpkgs#cocoapods --command bash -euc "$build"
    fi

# Copy the built app to /Applications, replacing any existing OverKeys.app.
app-install: app-build
    rm -rf "{{ app_dest }}"
    cp -R "{{ app_bundle }}" "{{ app_dest }}"
    xattr -d com.apple.quarantine "{{ app_dest }}" 2>/dev/null || true
    @echo "Installed. Grant Accessibility + Input Monitoring in System Settings."

# Without these two preferences OverKeys ignores the config and shows a
# standard keyboard.

# Turn on "Enable advanced settings" and "Use user layouts", then restart the app.
enable-user-layouts:
    #!/usr/bin/env bash
    set -euo pipefail
    osascript -e 'tell application "OverKeys" to quit' 2>/dev/null || true
    defaults write com.example.overkeys advancedSettingsEnabled -bool true
    defaults write com.example.overkeys useUserLayout -bool true
    open -a OverKeys

# Build and install the app, install the config, and enable user layouts.
all: app-install install-config enable-user-layouts
